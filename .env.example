# Reference for every variable the service reads. All are optional; the value
# shown is the built-in default.
#
# The application does not parse .env itself — copy this file to .env and feed
# it in, e.g. `docker run --env-file .env ...`, or export the variables in your
# shell before `make serve`.

# --- Models -----------------------------------------------------------------
# CTranslate2-format Whisper model directory.
WHISPER_MODEL_FOLDER=/model/whisper/

# Speaker diarization. When false, alignment/diarization models are not loaded
# at all and any request asking for diarization is rejected.
ENABLE_DIARIZATION=false
ALIGNMENT_MODEL_FOLDER=/model/alignment/
DIARIZATION_MODEL_FOLDER=/model/diarization/

# --- Decoding defaults ------------------------------------------------------
WHISPER_BEAM_SIZE=5
WHISPER_BATCH_SIZE=8

# --- Audio limits -----------------------------------------------------------
# Maximum accepted duration in seconds (default: 3 hours).
VTT_SUPPORTED_AUDIO_LENGTHS=10800
SUPPORTED_FORMATS=.m4a,.mp3,.wav

# --- Service ----------------------------------------------------------------
APP_PORT=7766
APP_WORKERS=1
# Public path prefix when served behind a reverse proxy, e.g. /whisper
UVICORN_ROOT_PATH=

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=INFO

# --- Hallucination trimming -------------------------------------------------
# A leading segment is dropped when no_speech_prob >= _NO_SPEECH_PROB and
# avg_logprob <= _LOG_PROB; a trailing segment is dropped when it is shorter
# than _DURATION seconds and no_speech_prob >= _NO_SPEECH_PROB. Either end is
# dropped unconditionally above HARD_NO_SPEECH_PROB_THRESHOLD.
REMOVE_FIRST_SEGMENT_NO_SPEECH_PROB=0.55
REMOVE_FIRST_SEGMENT_LOG_PROB=-1.2
REMOVE_LAST_SEGMENT_DURATION=2.5
REMOVE_LAST_SEGMENT_NO_SPEECH_PROB=0.8
HARD_NO_SPEECH_PROB_THRESHOLD=0.99

# --- OpenTelemetry (standard OTEL_* variables) ------------------------------
# Telemetry is off unless OTEL_SDK_DISABLED is explicitly set to false.
OTEL_SDK_DISABLED=true
OTEL_SERVICE_NAME=shuji-tool
# OTEL_EXPORTER_OTLP_ENDPOINT=http://collector:4317
# Per-signal overrides: OTEL_EXPORTER_OTLP_{TRACES,METRICS,LOGS}_ENDPOINT
# Only the grpc protocol is supported.
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
